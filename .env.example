# Local development — copy to .env (already gitignored).
# On Render these are set in the dashboard / render.yaml (do not commit secrets).

SECRET_KEY=change-me-locally
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# DATABASE_URL=  # leave empty for SQLite locally
SERVE_MEDIA=true
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@localhost
DJANGO_SUPERUSER_PASSWORD=change-me
SEED_ON_DEPLOY=false

# Email (production on Render) — recommended: SendGrid SMTP API key
# Create at https://app.sendgrid.com → Settings → API Keys (Mail Send permission)
# Verify DEFAULT_FROM_EMAIL as sender in SendGrid before going live.
SENDGRID_API_KEY=
DEFAULT_FROM_EMAIL=info@egentidspaservice.se
CONTACT_INBOX=info@egentidspaservice.se
# Canonical public URL (no trailing slash). On Render this is https://egentidspaservice.se
# PUBLIC_SITE_URL=https://egentidspaservice.se

# Alternative: Gmail SMTP (leave SENDGRID_API_KEY empty). Use an App Password, not
# the normal Gmail password. Gmail will send as EMAIL_HOST_USER, so set
# DEFAULT_FROM_EMAIL and CONTACT_INBOX to that Gmail until you switch provider.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=you@gmail.com
# CONTACT_INBOX=you@gmail.com

# SMS (production) — Twilio or Swedish 46elks. Leave unset to print SMS in the server log.
# SMS_BACKEND=auto
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+46XXXXXXXXX
# ELKS_USERNAME=
# ELKS_PASSWORD=
# ELKS_FROM=EGentid
