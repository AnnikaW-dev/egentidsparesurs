# Local development — copy to .env (already gitignored).
# On Render these are set in the dashboard / render.yaml (do not commit secrets).

SECRET_KEY=change-me-locally
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
# DATABASE_URL=  # leave empty for SQLite locally
SERVE_MEDIA=true
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@localhost
DJANGO_SUPERUSER_PASSWORD=change-me
SEED_ON_DEPLOY=false

# Email (production) — e.g. Gmail SMTP, SendGrid, or your host's mail server
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true
# DEFAULT_FROM_EMAIL=info@egentidsparesurs.se

# SMS (production) — Twilio or Swedish 46elks. Leave unset to print SMS in the server log.
# SMS_BACKEND=auto
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+46XXXXXXXXX
# ELKS_USERNAME=
# ELKS_PASSWORD=
# ELKS_FROM=EGentid
